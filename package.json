{
  "name": "@5havv/dsh-weixin",
  "version": "0.1.0",
  "description": "DeepSeek Harness (DSH) WeChat/Weixin channel plugin over Tencent's iLink Bot API",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "wechat",
    "weixin",
    "ilink",
    "chatbot"
  ],
  "license": "MIT",
  "author": "5havv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5havv/dsh-weixin.git"
  },
  "homepage": "https://github.com/5havv/dsh-weixin#readme",
  "bugs": {
    "url": "https://github.com/5havv/dsh-weixin/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "ilink_appid": "bot",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./bridge": {
      "types": "./lib/bridge/index.d.ts",
      "default": "./lib/bridge/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "verify": "tsx scripts/verify-plugin.ts && tsx scripts/verify-bridge.ts",
    "smoke": "tsx src/smoke.ts",
    "dev": "npm run build && dsh --profile web --patch ./examples/cordis.dev.yml"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
